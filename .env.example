# Vercel → Project → Settings → Environment Variables ішіне қосыңыз:
SUPABASE_SERVICE_ROLE_KEY=   # Supabase → inkluzif → Project Settings → API Keys → service_role (secret)
ANTHROPIC_API_KEY=           # Claude API кілті
ANTHROPIC_WORKSPACE_ID=      # (міндетті емес) кілт workspace-ке байланбаса, workspace ID
ELEVENLABS_API_KEY=          # ElevenLabs API кілті
ELEVENLABS_VOICE_ID=         # апайдың клондалған дауысының ID-сі
# Міндетті емес: SUPABASE_URL (әдепкі: inkluzif жобасы), CLAUDE_MODEL, ELEVENLABS_MODEL, APP_SECRET
#
# Мұғалім логині дерекқорда (app_admins кестесі). Жергілікті тексеру (npm run dev)
# кілтсіз демо режимде: логин admin, құпиясөз demo.
