# Vercel → Project → Settings → Environment Variables ішіне қосыңыз.
TEACHER_PASSWORD=            # мұғалім бетіне кіру құпиясөзі
SUPABASE_URL=                # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # Supabase → Project Settings → API → service_role (құпия!)
ANTHROPIC_API_KEY=           # Claude API кілті (console.anthropic.com)
ELEVENLABS_API_KEY=          # ElevenLabs API кілті
ELEVENLABS_VOICE_ID=         # апайдың клондалған дауысының ID-сі
# Міндетті емес:
# CLAUDE_MODEL=claude-opus-5-5
# ELEVENLABS_MODEL=eleven_v3
# APP_SECRET=                # ата-ана сілтемесінің қолтаңбасына арналған кездейсоқ ұзын мәтін
